{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information and multi-tenant association",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client", "employee"] },
        "companyId": { "type": "string" },
        "staffInviteId": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Client": {
      "title": "Client",
      "description": "Salon customers registered for interaction",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "Catalog": {
      "title": "Catalog",
      "description": "List of available services/procedures in the salon",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "price", "ownerId"]
    },
    "Professional": {
      "title": "Professional",
      "description": "Tenant team members and service specialists",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "ownerId"]
    },
    "StaffInvite": {
      "title": "StaffInvite",
      "description": "Verified onboarding invitation for team members",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "professionalId": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["companyId", "ownerUid", "professionalId", "email", "status"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Active staff member profile associated with a tenant",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "professionalId": { "type": "string" },
        "staffInviteId": { "type": "string" },
        "email": { "type": "string" },
        "active": { "type": "boolean" },
        "name": { "type": "string" }
      },
      "required": ["companyId", "professionalId", "email", "active"]
    },
    "Queue": {
      "title": "Queue",
      "description": "Real-time client walk-in queue item",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "service": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientName", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled appointments in establishment calendar",
      "type": "object",
      "properties": {
        "client": { "type": "string" },
        "service": { "type": "string" },
        "employee": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientPhone": { "type": "string" },
        "source": { "type": "string" },
        "bookingCode": { "type": "string" }
      },
      "required": ["client", "service", "time", "ownerId"]
    },
    "PublicBooking": {
      "title": "PublicBooking",
      "description": "Online booking requested through public marketplace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "clientEmail": { "type": "string" },
        "serviceName": { "type": "string" },
        "servicePrice": { "type": "number" },
        "serviceDuration": { "type": "number" },
        "professionalName": { "type": "string" },
        "professionalId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "bookingCode": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["ownerId", "clientName", "clientPhone", "serviceName", "date", "time", "bookingCode", "status"]
    },
    "PublicReview": {
      "title": "PublicReview",
      "description": "Verified post-service review left by customers",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "clientName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "serviceName": { "type": "string" },
        "bookingCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["companyId", "clientName", "rating", "comment", "bookingCode"]
    },
    "PublicListing": {
      "title": "PublicListing",
      "description": "Commercial profile published to public marketplace",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "city": { "type": "string" },
        "neighborhood": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "description": { "type": "string" },
        "coverUrl": { "type": "string" },
        "slug": { "type": "string" },
        "published": { "type": "boolean" },
        "services": { "type": "array" },
        "workingHours": { "type": "object" },
        "professionals": { "type": "array" }
      },
      "required": ["ownerId", "name", "category", "city", "published"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial bills, sales, and invoices",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["description", "amount", "type", "ownerId"]
    },
    "Company": {
      "title": "Company",
      "description": "Establishment settings information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "ownerId": { "type": "string" }
      }
    },
    "CompanyLicense": {
      "title": "CompanyLicense",
      "description": "Commercial license limits and active modules",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "expireDate": { "type": "string" },
        "aiUsage": { "type": "number" },
        "aiLimit": { "type": "number" },
        "waUsage": { "type": "number" },
        "waLimit": { "type": "number" },
        "unitsCount": { "type": "number" },
        "maxUsers": { "type": "number" },
        "addons": { "type": "array", "items": { "type": "string" } },
        "modules": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["companyId", "plan", "status"]
    },
    "PushToken": {
      "title": "PushToken",
      "description": "Registered device push notification token linked to users",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "platform": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["token", "userId", "role", "platform", "updatedAt"]
    },
    "FeatureFlag": {
      "title": "FeatureFlag",
      "description": "Feature flag assignments per company/user",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "pdv": { "type": "boolean" },
        "agenda": { "type": "boolean" },
        "crm": { "type": "boolean" },
        "whatsapp": { "type": "boolean" },
        "aiAssistant": { "type": "boolean" },
        "cashback": { "type": "boolean" },
        "whiteLabel": { "type": "boolean" },
        "marketplace": { "type": "boolean" },
        "mobileApp": { "type": "boolean" }
      },
      "required": ["companyId"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Prospective merchant leads captured via demo or landing page",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "source": { "type": "string" },
        "featureAttempted": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Prospective customer demo leads"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user configurations"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Salon customers"
    },
    "/catalog/{serviceId}": {
      "schema": "Catalog",
      "description": "Service catalog items"
    },
    "/professionals/{professionalId}": {
      "schema": "Professional",
      "description": "Team specialists"
    },
    "/staff_invites/{inviteId}": {
      "schema": "StaffInvite",
      "description": "Verified employee onboarding invitations"
    },
    "/staff_members/{staffUid}": {
      "schema": "StaffMember",
      "description": "Active staff roster per company"
    },
    "/queue/{itemId}": {
      "schema": "Queue",
      "description": "Waitlist items"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Schedules"
    },
    "/public_bookings/{bookingId}": {
      "schema": "PublicBooking",
      "description": "Consumer online reservations"
    },
    "/public_reviews/{reviewId}": {
      "schema": "PublicReview",
      "description": "Verified customer reviews"
    },
    "/public_listings/{listingId}": {
      "schema": "PublicListing",
      "description": "Directory showcase profiles"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial reports"
    },
    "/companies/{companyId}": {
      "schema": "Company",
      "description": "Salon details"
    },
    "/company_licenses/{licenseId}": {
      "schema": "CompanyLicense",
      "description": "Store licence modules, limits and expirations"
    },
    "/feature_flags/{flagId}": {
      "schema": "FeatureFlag",
      "description": "Custom feature flag switches"
    },
    "/push_tokens/{tokenId}": {
      "schema": "PushToken",
      "description": "Registered credentials for dispatching notifications"
    }
  }
}
