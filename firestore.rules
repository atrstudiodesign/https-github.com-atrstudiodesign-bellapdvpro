rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; // Default deny
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function tenantId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['companyId'])
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : request.auth.uid;
    }

    function isEmployee() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }

    function ownsTenant(data) {
      return isSignedIn() && !isEmployee() && request.auth.token.firebase.sign_in_provider != 'anonymous' && data.ownerId == tenantId();
    }

    function hasVerifiedInvite(inviteId, requestedCompany) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && inviteId is string
        && exists(/databases/$(database)/documents/staff_invites/$(inviteId))
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.status == 'pending'
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.companyId == requestedCompany
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.ownerUid == requestedCompany;
    }

    function validStock(data) {
      return !data.keys().hasAny(['stock']) || (data.stock is number && data.stock >= 0);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'client' && request.resource.data.companyId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && resource.data.role == 'client'
        && resource.data.companyId == request.auth.uid
        && request.resource.data.role == 'employee'
        && request.resource.data.staffInviteId is string
        && hasVerifiedInvite(request.resource.data.staffInviteId, request.resource.data.companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'companyId', 'staffInviteId'])
      ) || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.companyId == resource.data.companyId
          || (!resource.data.keys().hasAny(['companyId']) && request.resource.data.companyId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'lastLogin', 'provider', 'companyName', 'niche', 'companyId'])
      );
      allow delete: if isAdmin();
    }

    // Profiles can only be provisioned/changed by a trusted admin backend.
    // Employee self-read is limited to the document bearing their Firebase UID.
    // A request is NOT a granted staff account. A trusted administrator must
    // verify identity and provision users/staff_members before portal access.
    match /staff_invites/{inviteId} {
      allow read: if isAdmin() || (
        isSignedIn() && !isEmployee() &&
        resource.data.companyId == tenantId() &&
        request.auth.uid == tenantId()
      ) || (
        isSignedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == resource.data.email
        && resource.data.status == 'pending'
      );
      allow create: if isSignedIn()
        && !isEmployee()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && tenantId() == request.auth.uid
        && request.resource.data.keys().hasOnly(['companyId', 'ownerUid', 'professionalId', 'email', 'status', 'createdAt'])
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.professionalId is string
        && exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId))
        && get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /staff_members/{staffUid} {
      allow read: if isSignedIn() && (request.auth.uid == staffUid || isAdmin());
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == staffUid
        && request.resource.data.keys().hasOnly(['companyId', 'professionalId', 'staffInviteId', 'email', 'active', 'name'])
        && request.resource.data.staffInviteId is string
        && hasVerifiedInvite(request.resource.data.staffInviteId, request.resource.data.companyId)
        && request.resource.data.professionalId == get(/databases/$(database)/documents/staff_invites/$(request.resource.data.staffInviteId)).data.professionalId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/users/$(staffUid)).data.role == 'employee'
        && getAfter(/databases/$(database)/documents/users/$(staffUid)).data.companyId == request.resource.data.companyId
      );
      allow update, delete: if isAdmin();
    }

    // Read-only personal staff feed: created by privileged server/admin only.
    // A disabled employee loses all access immediately, regardless of cached UI state.
    function activeStaff(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/staff_members/$(uid))
        && get(/databases/$(database)/documents/staff_members/$(uid)).data.active == true
        && isEmployee();
    }

    match /staff_portal/{staffUid}/{section}/{itemId} {
      allow read: if (section in ['appointments', 'commissions', 'referrals', 'marketing'])
        && (activeStaff(staffUid) || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /catalog/{serviceId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data) && validStock(request.resource.data);
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validStock(request.resource.data)
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /queue/{itemId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update, delete: if isAdmin() || (ownsTenant(resource.data) && (request.method == 'delete' || request.resource.data.ownerId == resource.data.ownerId));
    }

    match /appointments/{appointmentId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data)
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.status in ['completed', 'pending']
        && request.resource.data.paymentMethod in ['pix', 'card', 'cash', 'split'];
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && ((companyId == tenantId() && !isEmployee()) || isAdmin());
      allow create: if isSignedIn() && companyId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && !isEmployee() && companyId == tenantId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'niche', 'address', 'phone', 'logo']));
      allow delete: if isAdmin();
    }

    match /company_licenses/{licenseId} {
      allow read: if isSignedIn() && ((licenseId == tenantId() && !isEmployee()) || isAdmin());
      allow write: if isAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if isSignedIn() && ((flagId == tenantId() && !isEmployee()) || isAdmin());
      allow write: if isAdmin();
    }

    match /push_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid) && (request.method == 'delete' || request.resource.data.userId == resource.data.userId);
    }

    match /bella_rate_limits/{limitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.routeGroup == resource.data.routeGroup
        && request.resource.data.windowStart == resource.data.windowStart
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow delete: if false;
    }

    match /voice_settings/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /voice_analytics/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
