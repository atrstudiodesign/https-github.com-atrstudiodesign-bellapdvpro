rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; // Default deny catch-all
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function tenantId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['companyId'])
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : request.auth.uid;
    }

    function isEmployee() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee';
    }

    function ownsTenant(data) {
      return isSignedIn() && !isEmployee() && request.auth.token.firebase.sign_in_provider != 'anonymous' && data.ownerId == tenantId();
    }

    function hasVerifiedInvite(inviteId, requestedCompany) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && inviteId is string
        && exists(/databases/$(database)/documents/staff_invites/$(inviteId))
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.status == 'pending'
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.companyId == requestedCompany
        && get(/databases/$(database)/documents/staff_invites/$(inviteId)).data.ownerUid == requestedCompany;
    }

    function validStock(data) {
      return !data.keys().hasAny(['stock']) || (data.stock is number && data.stock >= 0);
    }

    // =========================================================================
    // PUBLIC MARKETPLACE & DIRECTORY (Visitors, Customers & Public Showcase)
    // =========================================================================

    // Public directory listings: only explicitly published records are visible to guests.
    match /public_listings/{listingId} {
      allow list: if resource.data.published == true;
      allow get: if resource.data.published == true || (isSignedIn() && !isEmployee() && request.auth.uid == listingId && tenantId() == request.auth.uid);
      
      // Platform administrator override
      allow create, update: if isAdmin()
        && request.resource.data.ownerId is string
        && request.resource.data.name is string
        && request.resource.data.city is string
        && request.resource.data.slug is string
        && request.resource.data.keys().hasOnly(['ownerId','published','name','category','city','neighborhood','address','phone','description','coverUrl','slug','services','workingHours','professionals','bookingUrl','rating','reviewCount','updatedAt'])
        && request.resource.data.published is bool;

      // Verified tenant owner may publish/edit ONLY their own public record.
      allow create, update: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !isEmployee() && request.auth.uid == listingId && tenantId() == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.slug == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId','published','name','category','city','neighborhood','address','phone','description','coverUrl','slug','services','workingHours','professionals','bookingUrl','rating','reviewCount','updatedAt'])
        && request.resource.data.published is bool
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 80
        && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 60
        && request.resource.data.description is string && request.resource.data.description.size() <= 800
        && request.resource.data.services is list && request.resource.data.services.size() <= 30
        && request.resource.data.bookingUrl is string && request.resource.data.bookingUrl.size() <= 500
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 500
        && (request.resource.data.bookingUrl == '' || request.resource.data.bookingUrl.matches('https://.*'))
        && (request.resource.data.coverUrl == '' || request.resource.data.coverUrl.matches('https://.*'));
      
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == listingId && tenantId() == request.auth.uid && !isEmployee());
    }

    // Public online bookings requested by consumers (Multi-Tenant & Anti-Leak Isolation)
    match /public_bookings/{bookingId} {
      // Public clients must not forge confirmed reservations. Backend-only transactional writes required.
      allow create: if false;

      // Tenant owner can list and read only their own bookings; anonymous visitors CANNOT dump all bookings
      allow list: if isSignedIn() && !isEmployee() && resource.data.ownerId == tenantId();
      allow get: if (isSignedIn() && !isEmployee() && resource.data.ownerId == tenantId()) || isAdmin();
      allow update: if (isSignedIn() && !isEmployee() && resource.data.ownerId == tenantId()) || isAdmin();
      allow delete: if isAdmin();
    }

    // Verified customer reviews
    match /public_reviews/{reviewId} {
      allow read: if true; // Public verified testimonials
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['companyId','clientName','rating','comment','serviceName','bookingCode','createdAt'])
        && request.resource.data.companyId is string
        && request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2 && request.resource.data.clientName.size() <= 80
        && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
        && request.resource.data.bookingCode is string
        && request.resource.data.createdAt is string;
      allow update, delete: if isAdmin() || (isSignedIn() && !isEmployee() && resource.data.companyId == request.auth.uid);
    }

    // Commercial demo leads (write-only for prospective guests, read-only for admin)
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'companyName', 'phone', 'email', 'source', 'featureAttempted', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // MULTI-TENANT USERS, ROLES & PRIVILEGES
    // =========================================================================

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'client' && request.resource.data.companyId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && resource.data.role == 'client'
        && resource.data.companyId == request.auth.uid
        && request.resource.data.role == 'employee'
        && request.resource.data.staffInviteId is string
        && hasVerifiedInvite(request.resource.data.staffInviteId, request.resource.data.companyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'companyId', 'staffInviteId'])
      ) || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.companyId == resource.data.companyId
          || (!resource.data.keys().hasAny(['companyId']) && request.resource.data.companyId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'lastLogin', 'provider', 'companyName', 'niche', 'companyId'])
      );
      allow delete: if isAdmin();
    }

    match /staff_invites/{inviteId} {
      allow read: if isAdmin() || (
        isSignedIn() && !isEmployee() &&
        resource.data.companyId == tenantId() &&
        request.auth.uid == tenantId()
      ) || (
        isSignedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == resource.data.email
        && resource.data.status == 'pending'
      );
      allow create: if isSignedIn()
        && !isEmployee()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && tenantId() == request.auth.uid
        && request.resource.data.keys().hasOnly(['companyId', 'ownerUid', 'professionalId', 'email', 'status', 'createdAt'])
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.professionalId is string
        && exists(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId))
        && get(/databases/$(database)/documents/professionals/$(request.resource.data.professionalId)).data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /staff_members/{staffUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == staffUid || isAdmin() ||
        (!isEmployee() && resource.data.companyId == request.auth.uid && tenantId() == request.auth.uid)
      );
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == staffUid
        && request.resource.data.keys().hasOnly(['companyId', 'professionalId', 'staffInviteId', 'email', 'active', 'name'])
        && request.resource.data.staffInviteId is string
        && hasVerifiedInvite(request.resource.data.staffInviteId, request.resource.data.companyId)
        && request.resource.data.professionalId == get(/databases/$(database)/documents/staff_invites/$(request.resource.data.staffInviteId)).data.professionalId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/users/$(staffUid)).data.role == 'employee'
        && getAfter(/databases/$(database)/documents/users/$(staffUid)).data.companyId == request.resource.data.companyId
      );
      allow update: if isAdmin() || (
        isSignedIn() && !isEmployee()
        && resource.data.companyId == request.auth.uid
        && tenantId() == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
      );
      allow delete: if isAdmin();
    }

    // Read-only personal staff portal feed: restricted to active staff member or company owner
    function activeStaff(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && exists(/databases/$(database)/documents/staff_members/$(uid))
        && get(/databases/$(database)/documents/staff_members/$(uid)).data.active == true
        && isEmployee();
    }

    function ownsStaffMember(staffUid) {
      return isSignedIn() && !isEmployee()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && tenantId() == request.auth.uid
        && exists(/databases/$(database)/documents/staff_members/$(staffUid))
        && get(/databases/$(database)/documents/staff_members/$(staffUid)).data.companyId == request.auth.uid;
    }

    match /staff_portal/{staffUid}/{section}/{itemId} {
      allow read: if (section in ['appointments', 'commissions', 'referrals', 'marketing'])
        && (activeStaff(staffUid) || isAdmin() || ownsStaffMember(staffUid));
      allow create, update: if isAdmin() || (
        ownsStaffMember(staffUid)
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.keys().hasOnly(['companyId', 'title', 'date', 'time', 'status', 'amount'])
      );
      allow delete: if isAdmin() || (
        ownsStaffMember(staffUid)
      );
    }

    // =========================================================================
    // STRICT MULTI-TENANT ISOLATED DATA (Empresa A nunca acessa Empresa B)
    // =========================================================================

    // Clients / Customers (Private CRM)
    match /clients/{clientId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100;
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    // Catalog (Products & Services)
    match /catalog/{serviceId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data) && validStock(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100;
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validStock(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    // Team Professionals
    match /professionals/{professionalId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100;
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    // Walk-in queue items
    match /queue/{itemId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update, delete: if isAdmin() || (ownsTenant(resource.data) && (request.method == 'delete' || request.resource.data.ownerId == resource.data.ownerId));
    }

    // Internal Appointments (Schedule)
    match /appointments/{appointmentId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && ownsTenant(request.resource.data)
        && request.resource.data.client is string && request.resource.data.client.size() >= 1 && request.resource.data.client.size() <= 100
        && request.resource.data['service'] is string && request.resource.data['service'].size() >= 1 && request.resource.data['service'].size() <= 100
        && request.resource.data.status in ['confirmed', 'pending', 'cancelled', 'completed'];
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ['confirmed', 'pending', 'cancelled', 'completed']
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    // Financial Transactions & Sales (Strict Integrity)
    match /transactions/{transactionId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data)
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.status in ['completed', 'pending']
        && request.resource.data.paymentMethod in ['pix', 'card', 'cash', 'split'];
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // Company Settings
    match /companies/{companyId} {
      allow read: if isSignedIn() && ((companyId == tenantId() && !isEmployee()) || isAdmin());
      allow create: if isSignedIn() && companyId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && !isEmployee() && companyId == tenantId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'niche', 'address', 'phone', 'logo']));
      allow delete: if isAdmin();
    }

    // Company Licenses (Admin Protected)
    match /company_licenses/{licenseId} {
      allow read: if isSignedIn() && ((licenseId == tenantId() && !isEmployee()) || isAdmin());
      allow write: if isAdmin();
    }

    // Feature Flags (Admin Protected)
    match /feature_flags/{flagId} {
      allow read: if isSignedIn() && ((flagId == tenantId() && !isEmployee()) || isAdmin());
      allow write: if isAdmin();
    }

    // Device push tokens
    match /push_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid) && (request.method == 'delete' || request.resource.data.userId == resource.data.userId);
    }

    // Rate limits (Anti-abuse)
    match /bella_rate_limits/{limitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.routeGroup == resource.data.routeGroup
        && request.resource.data.windowStart == resource.data.windowStart
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow delete: if false;
    }

    match /voice_settings/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /voice_analytics/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
