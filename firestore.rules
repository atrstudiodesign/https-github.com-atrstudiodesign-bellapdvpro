rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; // Default deny
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function tenantId() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['companyId'])
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        : request.auth.uid;
    }

    function ownsTenant(data) {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && data.ownerId == tenantId();
    }

    function validStock(data) {
      return !data.keys().hasAny(['stock']) || (data.stock is number && data.stock >= 0);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == 'client' && request.resource.data.companyId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.companyId == resource.data.companyId
          || (!resource.data.keys().hasAny(['companyId']) && request.resource.data.companyId == request.auth.uid)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'lastLogin', 'provider', 'companyName', 'niche', 'companyId'])
      );
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /catalog/{serviceId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data) && validStock(request.resource.data);
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && validStock(request.resource.data)
      );
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /professionals/{professionalId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /queue/{itemId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data);
      allow update, delete: if isAdmin() || (ownsTenant(resource.data) && (request.method == 'delete' || request.resource.data.ownerId == resource.data.ownerId));
    }

    match /appointments/{appointmentId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous' && ownsTenant(request.resource.data);
      allow update: if isAdmin() || (ownsTenant(resource.data) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if ownsTenant(resource.data) || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if ownsTenant(resource.data) || isAdmin();
      allow create: if ownsTenant(request.resource.data)
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.status in ['completed', 'pending']
        && request.resource.data.paymentMethod in ['pix', 'card', 'cash', 'split'];
      allow update: if isAdmin() || (
        ownsTenant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if isSignedIn() && (companyId == tenantId() || isAdmin());
      allow create: if isSignedIn() && companyId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && companyId == tenantId() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'niche', 'address', 'phone', 'logo']));
      allow delete: if isAdmin();
    }

    match /company_licenses/{licenseId} {
      allow read: if isSignedIn() && (licenseId == tenantId() || isAdmin());
      allow write: if isAdmin();
    }

    match /feature_flags/{flagId} {
      allow read: if isSignedIn() && (flagId == tenantId() || isAdmin());
      allow write: if isAdmin();
    }

    match /push_tokens/{tokenId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid) && (request.method == 'delete' || request.resource.data.userId == resource.data.userId);
    }

    match /bella_rate_limits/{limitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.routeGroup == resource.data.routeGroup
        && request.resource.data.windowStart == resource.data.windowStart
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count']);
      allow delete: if false;
    }


    // Anonymous visitors may create only their own minimal, consented page-view events.
    // No public reads; enterprise analytics is available only to platform admins.
    match /visitor_events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['event', 'visitorId', 'route', 'occurredAt', 'source'])
        && request.resource.data.event == 'page_view'
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.source == 'bella_web'
        && request.resource.data.route in ['/landing', '/demo', '/login']
        && request.resource.data.occurredAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Authenticated customer lifecycle; only platform admins can list across accounts.
    match /commercial_events/{eventId} {
      allow create: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['event', 'userId', 'companyId', 'occurredAt', 'source'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId == request.auth.uid
        && request.resource.data.source == 'bella_web'
        && request.resource.data.event == 'account_login'
        && request.resource.data.occurredAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /voice_settings/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /voice_analytics/{logId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
